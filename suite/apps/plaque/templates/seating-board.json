{
  "format": "plaque-template",
  "version": 1,
  "id": "seating-board",
  "name": "Seating board — every table, A1",
  "description": "The board at the door: every table and who sits at it, at full size for a print shop or tiled at home.",
  "card": {
    "widthMm": 594,
    "heightMm": 841,
    "fold": "none",
    "foldPositionMm": 420.5,
    "bleedMm": 3
  },
  "sheet": {
    "page": "FIT",
    "marginTopMm": 10,
    "marginRightMm": 10,
    "marginBottomMm": 10,
    "marginLeftMm": 10,
    "gapXMm": 0,
    "gapYMm": 0,
    "cardRotationDeg": 0
  },
  "template": {
    "backgroundHex": "#fbf8f2",
    "rowScope": {
      "kind": "document"
    },
    "elements": [
      {
        "kind": "rect",
        "id": "frame",
        "x": 18,
        "y": 18,
        "w": 558,
        "h": 805,
        "z": 0,
        "fillHex": null,
        "strokeHex": "#b49a6a",
        "strokeWidthMm": 1.2,
        "dashed": false
      },
      {
        "kind": "text",
        "id": "title",
        "x": 40,
        "y": 40,
        "w": 514,
        "h": 70,
        "z": 1,
        "template": "Find your seat",
        "fontId": "great-vibes",
        "fontSizePt": 110,
        "align": "center",
        "vAlign": "middle",
        "lineHeight": 1.1,
        "colorHex": "#3b3127",
        "letterSpacingMm": 0,
        "fit": {
          "mode": "shrink",
          "minFontSizePt": 40,
          "maxLines": 1,
          "anchor": "align"
        }
      },
      {
        "kind": "line",
        "id": "rule",
        "x": 207,
        "y": 118,
        "w": 180,
        "h": 1,
        "z": 2,
        "strokeHex": "#b49a6a",
        "strokeWidthMm": 0.6,
        "dashed": false
      },
      {
        "kind": "grid",
        "id": "tables",
        "x": 40,
        "y": 140,
        "w": 514,
        "h": 660,
        "z": 3,
        "groupBy": "Table",
        "headingTemplate": "{{Table}}",
        "itemTemplate": "{{First Name}} {{Last Name}}",
        "columns": 3,
        "gapMm": 14,
        "fontId": "crimson",
        "fontSizePt": 26,
        "headingFontId": "marcellus",
        "headingScale": 1.35,
        "headingColorHex": "#7a5c3a",
        "align": "center",
        "lineHeight": 1.3,
        "colorHex": "#2b2620",
        "letterSpacingMm": 0,
        "fit": {
          "mode": "shrink",
          "minFontSizePt": 9,
          "maxLines": 1,
          "anchor": "align"
        }
      }
    ]
  }
}
